# Copy this file to .env and fill in real values.
# Never commit .env - it is gitignored.
#
# disputes_report.py expects one block per store below (MARY, LYN, MAGIE).
# The key is what you pass to ShopifyStore.from_env("MARY"). Each token needs
# the `read_shopify_payments_disputes` and `read_orders` Admin API scopes.

MARY_SHOPIFY_DOMAIN=ya6ker-ps.myshopify.com
MARY_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LYN_SHOPIFY_DOMAIN=your-lyn-store.myshopify.com
LYN_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

MAGIE_SHOPIFY_DOMAIN=your-magie-store.myshopify.com
MAGIE_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
