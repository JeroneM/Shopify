# Copy this file to .env and fill in real values.
# Never commit .env - it is gitignored.
#
# Add one block per store, using a short uppercase key (e.g. MARY, LYN, MAGIE)
# as the prefix. The key is what you pass to ShopifyStore.from_env("MARY").

MARY_SHOPIFY_DOMAIN=ya6ker-ps.myshopify.com
MARY_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LYN_SHOPIFY_DOMAIN=
LYN_SHOPIFY_ACCESS_TOKEN=
MAGIE_SHOPIFY_DOMAIN=
MAGIE_SHOPIFY_ACCESS_TOKEN=
ELSIE_SHOPIFY_DOMAIN=
ELSIE_SHOPIFY_ACCESS_TOKEN=
