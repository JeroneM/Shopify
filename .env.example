# Copy this file to .env and fill in real values.
# Never commit .env - it is gitignored.
#
# One block per store, keyed by a short uppercase prefix. The prefix is what
# fetch_chargebacks.py uses to label the store, and what you pass to
# ShopifyStore.from_env("MARY"). Stores are discovered automatically from every
# <KEY>_SHOPIFY_DOMAIN present in the environment.
#
# The access token needs the read_shopify_payments_disputes scope, plus
# read_orders if you want customer names and order numbers on the dashboard.
# Create one per store under Settings > Apps and sales channels >
# Develop apps > Configure Admin API scopes.

MARY_SHOPIFY_DOMAIN=ya6ker-ps.myshopify.com
MARY_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MARY_SHOPIFY_LABEL=Mary's Tanks

MAGIE_SHOPIFY_DOMAIN=4r0jeh-pr.myshopify.com
MAGIE_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAGIE_SHOPIFY_LABEL=Maggies Tanks

LYN_SHOPIFY_DOMAIN=your-lyn-store.myshopify.com
LYN_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LYN_SHOPIFY_LABEL=Lyn's Tanks

ELSIE_SHOPIFY_DOMAIN=your-elsie-store.myshopify.com
ELSIE_SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELSIE_SHOPIFY_LABEL=Simply Elsie

# The token may also be spelled SHOPIFY_TOKEN_<KEY>, which is what the deploy
# environment already sets for the Mary and James store. Either name works;
# the domain is still required.
MJ_SHOPIFY_DOMAIN=your-mj-store.myshopify.com
# SHOPIFY_TOKEN_MJ=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MJ_SHOPIFY_LABEL=Mary and James

# Optional: pin the store list and its order instead of auto-discovering.
# SHOPIFY_STORES=MARY,MAGIE,LYN,MJ,ELSIE
